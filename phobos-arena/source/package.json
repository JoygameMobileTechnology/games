{
  "name": "phobos-arena",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "lan": "npm run build && tsx server/index.ts",
    "lan:serve": "tsx server/index.ts",
    "build:pages": "tsc --noEmit && vite build --base=/games/phobos-arena/ --outDir dist-pages"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.3",
    "qrcode": "^1.5.4",
    "three": "^0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
